# Matrix Trader 7.0 environment template
# Copy this file to .env locally or on the server, then fill only the keys you use.

# App
MATRIX_PORT=8080

# AI providers. Configure only the services you want to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
GROQ_API_KEY=

# Local models (optional)
OLLAMA_BASE_URL=                    # e.g. http://localhost:11434

# Custom OpenAI-compatible endpoint (optional).
# Configure its URL/model in Tools -> Super User AI Control Center.
CUSTOM_AI_API_KEY=

# Optional path overrides. Defaults are data/ai_settings.json and data/signals.db.
MT7_AI_SETTINGS_PATH=
MT7_AI_TELEMETRY_DB_PATH=

# Cached Cipher evidence collectors. Defaults are intentionally low-frequency.
SOCIAL_INTERVAL_SECONDS=1800
SOCIAL_RETENTION_DAYS=30
CATALYST_INTERVAL_SECONDS=900
CATALYST_RETENTION_DAYS=90
TOKENOMICS_INTERVAL_SECONDS=21600
TOKENOMICS_RETENTION_DAYS=180

# Optional MEXC private endpoints. Public market data does not need these.
MEXC_API_KEY=
MEXC_API_SECRET=

# Optional Hyperliquid read-only account status. Public scans do not need this.
HL_WALLET_ADDRESS=

# Optional derivatives market context. Used to enrich market/signal data when present.
COINGLASS_API_KEY=

# Execution — disabled by default. Do not change until P11 is built and validated.
LIVE_TRADING_ENABLED=false
MATRIX_EXECUTION_MODE=disabled      # disabled | read_only | paper_bot | assisted | micro_live
MAX_DAILY_LOSS_USDT=25
MAX_OPEN_LIVE_POSITIONS=1
MAX_ORDER_NOTIONAL_USDT=20
MEXC_API_KEY=                        # required for P8 account integration
MEXC_API_SECRET=                     # required for P8 account integration

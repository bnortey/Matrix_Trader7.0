# Matrix Trader 7.0 environment template
# Copy this file to .env locally or on the server, then fill only the keys you use.

# App
MATRIX_PORT=8080

# AI provider fallback chain: Claude -> Gemini -> DeepSeek -> Groq
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional MEXC private endpoints. Public market data does not need these.
MEXC_API_KEY=
MEXC_API_SECRET=
